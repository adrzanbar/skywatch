FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/SkyWatch.Aggregator/SkyWatch.Aggregator.csproj \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 9100
ENTRYPOINT ["dotnet", "SkyWatch.Aggregator.dll"]
