{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.Http.HttpClient.k0sstreams": "Warning"
    }
  },
  "Aggregator": {
    "SnapshotSeconds": 10
  },
  "Airports": {
    "HoldingMinAltitudeFt": 3000,
    "HoldingMaxAltitudeFt": 15000,
    "HoldingMinSpeedKt": 150,
    "HoldingMaxSpeedKt": 300,
    "HoldingWindowSeconds": 120,
    "HoldingTurnDegrees": 270,
    "AircraftTimeoutMinutes": 10
  },
  "Messaging": {
    "Mode": "InMemory",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "skywatch-aggregator"
    },
    "K0sStreams": {
      "BaseUrl": "http://localhost:9090"
    }
  }
}
