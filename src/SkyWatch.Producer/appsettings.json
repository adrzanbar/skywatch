{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.Http.HttpClient.IAircraftSource": "Warning"
    }
  },
  "Adsb": {
    "BaseUrl": "https://api.adsb.lol",
    "PollSeconds": 10,
    "RequestSpacingMs": 500,
    "MaxPositionsPerSnapshot": 200,
    "IncludeMilitary": true,
    "IncludeEmergencySquawks": true,
    "EmergencySquawks": ["7500", "7600", "7700"],
    "Zones": [
      { "Name": "buenos-aires", "Latitude": -34.6, "Longitude": -58.4, "RadiusNm": 250 },
      { "Name": "madrid", "Latitude": 40.47, "Longitude": -3.56, "RadiusNm": 250 },
      { "Name": "new-york", "Latitude": 40.64, "Longitude": -73.78, "RadiusNm": 250 },
      { "Name": "london", "Latitude": 51.47, "Longitude": -0.45, "RadiusNm": 250 },
      { "Name": "tokyo", "Latitude": 35.55, "Longitude": 139.78, "RadiusNm": 250 }
    ]
  },
  "Observability": {
    "OtlpEndpoint": "",
    "MetricsPort": 9100
  },
  "Messaging": {
    "Mode": "InMemory",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "skywatch-producer"
    },
    "K0sStreams": {
      "BaseUrl": "http://localhost:9090"
    }
  }
}
