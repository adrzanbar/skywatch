{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "System.Net.Http.HttpClient.k0sstreams": "Warning"
    }
  },
  "Tracker": {
    "RapidDescentFpm": -3000,
    "RapidDescentRecoveryFpm": -1000,
    "SignalLossSeconds": 60,
    "AircraftTimeoutMinutes": 10,
    "Watchlist": []
  },
  "Messaging": {
    "Mode": "InMemory",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "skywatch-tracker"
    },
    "K0sStreams": {
      "BaseUrl": "http://localhost:9090"
    }
  }
}
